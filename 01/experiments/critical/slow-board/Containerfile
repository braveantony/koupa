# Test-only helper image for experiments/critical/05-blocked-write.sh.
FROM docker.io/library/golang:1.26 AS build
WORKDIR /src
COPY experiments/critical/slow-board/main.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o /out/slow-board main.go

FROM gcr.io/distroless/static-debian12:nonroot@sha256:52dcfbabb7457ea47c82f6e13af8c8a4a1d9f7b0145142b3ecab20f2b888411d
COPY --from=build /out/slow-board /slow-board
USER nonroot
ENTRYPOINT ["/slow-board"]
